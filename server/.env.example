# Port the API listens on (the Vite dev server proxies /api here)
PORT=4000

# Secret used to sign login tokens. If unset, a random one is generated and
# stored in storage/.jwt-secret.
JWT_SECRET=

# HTTPS-only session cookies. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# Where the SQLite database, uploads and generated assets live.
STORAGE_DIR=./storage

# Which generator backend to use. Only "mock" exists today.
GENERATOR=mock

# --- AI text model (managed by this server) ---
# The server talks to Ollama (https://ollama.com). If nothing answers at a local
# OLLAMA_URL it starts `ollama serve` itself, downloads OLLAMA_MODEL if missing,
# preloads it and queues requests. Set TEXT_MODEL=none to use keyword matching only.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=120000
# OLLAMA_AUTOSTART=false   # don't start Ollama (e.g. it runs in another container)
# OLLAMA_AUTOPULL=false    # don't download the model automatically
# OLLAMA_BIN=C:\path\to\ollama.exe
# OLLAMA_MAX_QUEUE=6       # requests allowed to wait for the model

# --- Web reference images ---
# For people, animals, weapons and other hard objects, the server searches
# Wikimedia Commons and Openverse for openly licensed reference photos.
# REFERENCES=off
